PORT=3000
# Paste the PostgreSQL connection string from your database provider (for example Neon).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Replace with a random secret of at least 32 characters before deployment.
JWT_SECRET=replace-this-with-a-long-random-secret-before-deploying
NODE_ENV=development
# Optional: use DATABASE_SSL=disable only for a local PostgreSQL server without TLS.
# DATABASE_SSL=disable
# Optional: restrict API calls to a separate front-end site.
# CORS_ORIGIN=https://your-site.netlify.app
